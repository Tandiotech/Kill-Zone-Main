# =============================================================================
# KILLZONE (Kill-Zone-Main) — environment
# Copy to .env and fill in. .env is gitignored; never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
# Server-only secrets (never exposed to the browser)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# DECISION: each app uses its OWN Supabase project (not shared).
# This app -> the "KILLZONE" project. Do NOT paste the other app's keys here.
# Separate projects mean separate allowed_users allowlists, so access to
# KILLZONE does not grant access to the other dashboard.
#
# Per-project setup checklist:
#   1. Create the project at supabase.com
#   2. SQL Editor -> run supabase/migrations/001_invite_auth.sql
#   3. Authentication -> Providers -> Email: disable public sign-ups
#   4. Authentication -> URL Configuration:
#        Site URL       https://killzone.tandiotech.com
#        Redirect URLs  https://killzone.tandiotech.com/auth/callback
#   5. Project Settings -> API: copy the three values below
# -----------------------------------------------------------------------------

# Supabase project for KILLZONE (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret for direct-login tokens.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if empty — always set a dedicated one in production.
# Generate: openssl rand -hex 48
APP_AUTH_SECRET=

# Public URL of THIS app, no trailing slash.
# Used for the Supabase magic-link redirect: <PUBLIC_APP_URL>/auth/callback
# Must be added under Supabase -> Authentication -> URL Configuration -> Redirect URLs.
PUBLIC_APP_URL=https://killzone.tandiotech.com

# Only needed when the browser UI is served from a DIFFERENT host than this API
# (e.g. Netlify UI + this box as API). Comma-separated origins. Leave empty for same-origin.
CORS_ORIGINS=

# Port the Express server listens on inside the container. Setting PORT also
# makes it bind 0.0.0.0 instead of 127.0.0.1 (see server/index.ts).
PORT=5000

# -----------------------------------------------------------------------------
# Client (Vite) — PUBLIC values, inlined into the JS bundle at BUILD time.
# Changing these requires a rebuild, not just a restart.
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave EMPTY for same-origin (UI and API served by the same Express process).
# Only set when the static UI is hosted separately from the API.
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# newsapi.org key for the live headline feed (/api/market-narratives).
# Without it that endpoint degrades; the rest of the app works.
NEWS_API_KEY=
